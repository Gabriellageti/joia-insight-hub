# Public browser configuration (RLS still applies).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Only the exact value true enables the optional assistant.
# Missing/invalid values are disabled. Never prefix this flag or secrets with VITE_.
AI_ASSISTANT_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Vercel injects OIDC; do not add an AI_GATEWAY_API_KEY for this release.
